    "\n",
    "ax.set_yticks(np.round(np.arange(0, 1.2, 0.2), 1))\n",
    "ax.set_yticklabels(ax.get_yticks(), fontsize=12)\n",
    "\n",
    "fig.savefig(\"_figs/\"+infection_type+'-'+'fates-by-lin-'+reg_string+'.png', dpi=300, bbox_inches=\"tight\")"
